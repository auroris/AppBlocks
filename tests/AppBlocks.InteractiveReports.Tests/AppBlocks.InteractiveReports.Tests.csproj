<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <ProjectReference Include="../../src/AppBlocks.InteractiveReports/AppBlocks.InteractiveReports.csproj" />
    <!-- The drivers AppBlocks leaves to a site. SQLite and SQL Server come through Umbraco.Cms. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.300" />
    <Using Include="Xunit" />
    <Compile Include="../AppBlocks.Tests/BlockPages.cs" Link="BlockPages.cs" />
    <Compile Include="../AppBlocks.Tests/LocalDbFactAttribute.cs" Link="LocalDbFactAttribute.cs" />
    <Compile Include="../AppBlocks.Tests/RestrictedSqlServer.cs" Link="RestrictedSqlServer.cs" />
  </ItemGroup>
</Project>
