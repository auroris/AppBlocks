<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <ProjectReference Include="../../src/AppBlocks.Documents/AppBlocks.Documents.csproj" />
    <Using Include="Xunit" />
    <Content Update="Views/**/*.cshtml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
