@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Options
@using AppBlocks.Blocks
@using AppBlocks.DataSources
@using AppBlocks.Forms
@using AppBlocks.Tabular
@model AppBlockView
@inject FormResourceRegistry Resources
@inject IVariationContextAccessor VariationContext
@inject IConfiguration Configuration
@inject IOptions<TabularOptions> Options
@inject AppBlocksText Text
@*
    The rows of a record, edited several at a time. The server renders the frame and the column headings; the runtime
    loads the rows from the tabular endpoints, draws one input per cell, and saves every change in one batch. Inside a form the
    block waits for the form's record (the app-form:loaded and app-form:saved events) and asks with the record's key;
    on its own it asks at once with the page's address. Inside a form the caller can save, its changes go with the form's
    own save, which names the block by data-block. The controls carry form="" so the enclosing form never submits
    them, and buttons are type="button" for the same reason. The runtime's inputs carry data-column, never data-field,
    so the enclosing form does not collect them. Anonymous readers need a public data source and access to the owner.
*@
@{
    var item = Model.Block;
    var block = TabularBlock.Read(item.Content, Options.Value.MaxRows);
    var culture = VariationContext.VariationContext?.Culture;
    var apiQuery = culture is not null && Model.Page.Cultures.ContainsKey(culture) ? "?" + AppBlockContent.CultureParameter + "=" + Uri.EscapeDataString(culture) : "";
    var api = Context.Request.PathBase + TabularEndpoints.Route(Configuration) + "/" + Model.Page.Key + "/" + item.ContentKey + apiQuery;
    var ownedByForm = block.OwnedByForm && Model.Form is not null;
    // A class that only Members reach refuses an anonymous visitor's every call, so the notice replaces rows that would only fail.
    var owner = block.OwnedByForm ? Model.Form?.Resource : await Resources.FindAsync(block.OwnerResource!);
    var membersOnly = Model.Anonymous && owner is not null && FormResourceAccess.Refusal(owner, Context.User) is not null;
    var id = "tabular-" + item.ContentKey.ToString("N");
    var level = Math.Clamp(Model.HeadingLevel, 2, 6);
    var heading = new TagBuilder("h" + level);
    heading.AddCssClass("ah-tabular__title");
    heading.Attributes["id"] = id + "-title";
    heading.InnerHtml.Append(block.Heading ?? "");
    // The headings are known before any row is: the data source's fields, or the configured names while it is unavailable.
    var columns = await Resources.FindAsync(block.DataSource) is SqlDataSource source
        ? block.Columns(source.Fields)
        : block.Fields.Select(name => new FormField(name, name, "text")).ToArray();
    // An editor's own label wins; the package's default goes through the site's texts.
    var addLabel = block.AddLabel == TabularBlock.DefaultAddLabel ? Text["tabularAddRow", TabularBlock.DefaultAddLabel] : block.AddLabel;
    var saveLabel = block.SaveLabel == TabularBlock.DefaultSaveLabel ? Text["tabularSaveRows", TabularBlock.DefaultSaveLabel] : block.SaveLabel;
}
@if (!Model.Admitted || membersOnly || Model.Anonymous && await Resources.FindAsync(block.DataSource) is not SqlDataSource { AllowsAnonymousRead: true })
{
    <p class="app-block-signin" role="status">@Text["tabularSignIn", "Sign in to see the rows."]</p>
}
else if (block.OwnedByForm && Model.Form is null)
{
    <p role="alert">@Text["tabularNoOwner", "This Tabular form block is not inside a form and names no owner."]</p>
}
else
{
    <section class="app-tabular ah-tabular" id="@id" data-app-tabular data-api="@api" data-block="@item.ContentKey" data-owner="@(ownedByForm ? "form" : "page")"
        data-key-parameter="@(Model.Form?.KeyParameter ?? "id")" data-read-only="@block.ReadOnly.ToString().ToLowerInvariant()"
        data-max-rows="@block.MaxRows" data-empty-message="@(block.EmptyMessage ?? Text["tabularEmpty", "No rows yet."])" data-anonymous="@(Model.Anonymous ? "true" : null)" aria-labelledby="@(block.Heading is null ? null : id + "-title")">
        @if (block.Heading is not null) { @heading }
        @if (block.Help is not null) { <p class="ah-tabular__help">@block.Help</p> }
        <div class="app-tabular-message" role="status" aria-live="polite"></div>
        <div class="app-tabular-errors" role="alert" tabindex="-1" hidden></div>
        <div class="app-tabular-scroll ah-tabular__scroll">
            <table class="app-tabular-table">
                <thead>
                    <tr>
                        @foreach (var column in columns)
                        {
                            <th scope="col" data-column="@column.Key">@column.Label@(column.Required ? " *" : "")</th>
                        }
                        <th scope="col" class="app-tabular-actions-head"><span class="visually-hidden">@Text["tabularActions", "Actions"]</span></th>
                    </tr>
                </thead>
                <tbody aria-busy="true"></tbody>
            </table>
        </div>
        @if (!block.ReadOnly)
        {
            <div class="app-tabular-toolbar ah-tabular__toolbar" hidden>
                <button type="button" form="" data-tabular-add>@addLabel</button>
                <button type="button" form="" data-tabular-save>@saveLabel</button>
            </div>
        }
    </section>
}
