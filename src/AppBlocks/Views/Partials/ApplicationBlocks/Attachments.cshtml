@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Options
@using AppBlocks.Attachments
@using AppBlocks.Blocks
@using AppBlocks.Forms
@model AppBlockView
@inject IOptions<AttachmentSettings> Settings
@inject IVariationContextAccessor VariationContext
@inject IConfiguration Configuration
@inject FormResourceRegistry Resources
@inject AppBlocksText Text
@*
    The files of a record. The server renders the frame and the limits; the runtime loads the list from the
    attachments endpoints and performs the uploads. Inside a form the block waits for the form's record (the
    app-form:loaded and app-form:saved events) and asks with the record's key; on its own it asks at once with
    the page's address. Before the form's record exists, data-new-uploads says whether this caller may upload
    pending files under the form's submission key, which the runtime adopts to the record once the form saves.
    The controls carry form="" so the enclosing form never submits them, and buttons are type="button" for the
    same reason.
*@
@{
    var item = Model.Block;
    var block = AttachmentBlock.Read(item.Content, Settings.Value);
    var culture = VariationContext.VariationContext?.Culture;
    var apiQuery = culture is not null && Model.Page.Cultures.ContainsKey(culture) ? "?" + AppBlockContent.CultureParameter + "=" + Uri.EscapeDataString(culture) : "";
    var api = Context.Request.PathBase + AttachmentEndpoints.Route(Configuration) + "/" + Model.Page.Key + "/" + item.ContentKey + apiQuery;
    var ownedByForm = block.OwnedByForm && Model.Form is not null;
    // A class that only Members reach refuses an anonymous visitor's every call, so the notice replaces a list that would only fail.
    var owner = block.OwnedByForm ? Model.Form?.Resource : await Resources.FindAsync(block.OwnerResource!);
    var membersOnly = Model.Anonymous && owner is not null && FormResourceAccess.Refusal(owner, Context.User) is not null;
    var id = "attachments-" + item.ContentKey.ToString("N");
    var level = Math.Clamp(Model.HeadingLevel, 2, 6);
    var heading = new TagBuilder("h" + level);
    heading.AddCssClass("ah-attachments__title");
    heading.Attributes["id"] = id + "-title";
    heading.InnerHtml.Append(block.Heading ?? "");
}
@if (!Model.Admitted || membersOnly)
{
    <p class="app-block-signin" role="status">@Text["attachmentsSignIn", "Sign in to see the files."]</p>
}
else if (block.OwnedByForm && Model.Form is null)
{
    <p role="alert">@Text["attachmentsNoOwner", "This Attachments block is not inside a form and names no owner."]</p>
}
else
{
    var newUploads = false;
    if (ownedByForm && string.IsNullOrWhiteSpace(Context.Request.Query[Model.Form!.KeyParameter].ToString()))
    {
        try
        {
            newUploads = await AttachmentAccess.AllowsNewUploadsAsync(block, Model.Form!, Context.User, Model.Page.Key, item.ContentKey,
                FormEndpoints.Parameters(Context.Request.Query), Context.RequestAborted);
        }
        // A class that fails here fails the form's own load too, which reports it; the block keeps asking for a saved record.
        catch (Exception error) when (error is not OperationCanceledException) { }
    }
    <section class="app-attachments ah-attachments" id="@id" data-app-attachments data-api="@api" data-owner="@(ownedByForm ? "form" : "page")"
        data-key-parameter="@(Model.Form?.KeyParameter ?? "id")" data-read-only="@block.ReadOnly.ToString().ToLowerInvariant()" data-new-uploads="@(newUploads ? "allowed" : "save-first")"
        data-max-size="@block.Limits.MaxFileSize" data-accept="@block.Limits.Accept" data-anonymous="@(Model.Anonymous ? "true" : null)" aria-labelledby="@(block.Heading is null ? null : id + "-title")">
        @if (block.Heading is not null) { @heading }
        @if (block.Help is not null) { <p class="ah-attachments__help">@block.Help</p> }
        <div class="app-attachments-message" role="status" aria-live="polite"></div>
        <div class="app-attachments-errors" role="alert" tabindex="-1" hidden></div>
        <ul class="app-attachments-list ah-attachments__list" aria-busy="true"></ul>
        @if (!block.ReadOnly)
        {
            <div class="app-attachments-upload ah-attachments__upload" hidden>
                <div class="app-attachments-dashboard" data-attachment-dashboard></div>
                @if (block.Purposes.Count > 0)
                {
                    <label><span>@Text["attachmentsPurpose", "Purpose"]</span>
                        <select form="" data-attachment-purpose>
                            <option value="">@Text["attachmentsChoosePurpose", "Choose a purpose"]</option>
                            @foreach (var purpose in block.Purposes) { <option value="@purpose">@purpose</option> }
                        </select>
                    </label>
                }
                <label><span>@Text["attachmentsLabel", "Label"]</span> <input type="text" form="" data-attachment-label maxlength="200" autocomplete="off"></label>
                <label><span>@Text["attachmentsNotes", "Notes"]</span> <input type="text" form="" data-attachment-notes maxlength="1000" autocomplete="off"></label>
                <button type="button" form="" data-attachment-upload disabled>@Text["attachmentsUpload", "Upload"]</button>
            </div>
        }
    </section>
}
