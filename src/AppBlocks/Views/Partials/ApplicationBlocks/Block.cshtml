@using Umbraco.Extensions
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Strings
@using AppBlocks.Blocks
@using AppBlocks.Forms
@using AppBlocks.DataSources
@model AppBlockView
@inject FormResourceRegistry Resources
@inject AppPageAssets Assets
@inject PublishedDataCatalog Definitions
@inject ListOfValuesService Lists
@inject IVariationContextAccessor VariationContext
@inject IEnumerable<IAppBlockPlugin> Plugins
@inject AppBlocks.Blocks.AppBlocksText Text
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var item = Model.Block;
    var block = item.Content;
    var alias = block.ContentType.Alias;
    // Umbraco returns an empty string, not null, for a text property nobody filled in, so a ?? fallback needs this.
    string? Property(string property) => block.Value<string>(property) is { } value && !string.IsNullOrWhiteSpace(value) ? value : null;
    var heading = Property("heading");
    var paperReport = block.Value<IPublishedContent>("paperReport");
    var printUrl = paperReport is null ? null : Context.RequestServices.GetService<AppBlocks.DocumentOutput.IAppDocumentLinks>()?.Url(paperReport.Key, Context.Request.PathBase);
    var culture = VariationContext.VariationContext?.Culture;
    var apiQuery = culture is not null && Model.Page.Cultures.ContainsKey(culture) ? "?" + AppBlockContent.CultureParameter + "=" + Uri.EscapeDataString(culture) : "";
}
@if (alias == AppBlockSchema.FormsContainerAlias)
{
    var forms = block.Value<BlockGridModel>("forms") ?? BlockGridModel.Empty;
    <div class="app-forms-container">
        @await Html.PartialAsync("~/Views/Partials/ApplicationBlocks/Items.cshtml", new AppBlockItems(Model.Page, forms, forms.GridColumns ?? 12,
            MemberId: Model.MemberId, Variables: Model.Variables))
    </div>
}
else if (alias == "appForm" && !Model.Admitted)
{
    <p class="app-block-signin" role="status">@Text["signInToUseForm", "Sign in to use this form."]</p>
}
else if (Plugins.FirstOrDefault(plugin => plugin.Alias == alias) is { } plugin)
{
    @await Html.PartialAsync(plugin.ViewPath, Model)
}
else if (alias == "appForm")
{
    var definition = await FormDefinition.ResolveAsync(Model.Page, item.ContentKey, Resources, Definitions, apiQuery.Length > 0 ? culture : null, Plugins);
    if (definition is null)
    {
        <p role="alert">@Text["formInvalid", "This form has an invalid resource or field configuration."]</p>
    }
    else if (Model.Anonymous && await FormAccess.RefusesAnonymousAsync(definition, Model.Page.Key, Context))
    {
        @* The class said no before the runtime asked, so there is no form to show and nothing to flash. *@
        <p class="app-block-signin" role="status">@Text["signInToUseForm", "Sign in to use this form."]</p>
    }
    else
    {
        var destination = definition.ReturnUrl(Context.Request.PathBase);
        var api = Context.Request.PathBase + AppBlocks.AppBlocksRoutes.Under(Configuration, $"forms/{Model.Page.Key}/{item.ContentKey}") + apiQuery;
        <form class="app-form" data-label-position="@(string.Equals(block.Value<string>("labelPosition")?.Trim(), "left", StringComparison.OrdinalIgnoreCase) ? "left" : "top")" data-app-form data-api="@api"
            data-key-parameter="@definition.KeyParameter" data-return="@destination" data-anonymous="@(Model.Anonymous ? "true" : null)" novalidate>
            @if (!string.IsNullOrWhiteSpace(heading)) { <h2>@heading</h2> }
            <div class="app-form-message" role="status" aria-live="polite"></div>
            <div class="app-form-errors" role="alert" tabindex="-1" hidden></div>
            @if (printUrl is not null && !Model.Anonymous)
            {
                <p><a href="@printUrl" target="_blank" rel="noopener" data-print data-print-url="@printUrl" data-print-key-parameter="@definition.KeyParameter" hidden>@Text["print", "Print"]</a></p>
            }
            <fieldset class="app-form-body" disabled>
                @foreach (var area in item.Areas)
                {
                    @await Html.PartialAsync("~/Views/Partials/ApplicationBlocks/Items.cshtml", new AppBlockItems(Model.Page, area, area.ColumnSpan, definition,
                        Model.MemberId, string.IsNullOrWhiteSpace(heading) ? Model.HeadingLevel : Model.HeadingLevel + 1, Model.Variables))
                }
                @if (!AppBlockContent.Flatten(item.Areas.SelectMany(a => a)).Any(b => b.Content.ContentType.Alias == "appActions"))
                {
                    <div class="app-form-actions"><button type="submit" data-save>@Text["save", "Save"]</button><a href="@destination">@Text["cancel", "Cancel"]</a><button type="button" data-delete hidden>@Text["delete", "Delete"]</button></div>
                }
            </fieldset>
        </form>
    }
}
else if (alias == "appFieldset")
{
    var help = Property("helpText");
    <fieldset class="app-fieldset">
        <legend>@heading</legend>
        @if (help is not null) { <p class="app-fieldset-help">@help</p> }
        @foreach (var area in item.Areas)
        {
            @await Html.PartialAsync("~/Views/Partials/ApplicationBlocks/Items.cshtml", new AppBlockItems(Model.Page, area, area.ColumnSpan, Model.Form, Model.MemberId, Model.HeadingLevel, Model.Variables))
        }
    </fieldset>
}
else if (AppBlockSchema.ColumnLayoutAliases.Contains(alias))
{
    @await Html.PartialAsync("~/Views/Partials/ApplicationBlocks/Layout.cshtml", Model)
}
else if (alias == AppBlockSchema.RegionAlias)
{
    @await Html.PartialAsync("~/Views/Partials/ApplicationBlocks/Region.cshtml", Model)
}
else if (alias == AppBlockSchema.RichTextAlias)
{
    @* Rich text takes the theme's typography from the ah-rich-text hook. Umbraco's own views write the editor's
       HTML unencoded; this partial is a plain Razor view, so it does that explicitly. *@
    <div class="ah-rich-text">@Html.Raw(block.Value<IHtmlEncodedString>("text")?.ToHtmlString())</div>
}
else if (alias == AppBlockSchema.HtmlAlias)
{
    @* Raw HTML renders as written: back-office access is the trust boundary. *@
    @Html.Raw(block.Value<string>("html"))
}
else if (alias == AppBlockSchema.CssAlias)
{
    @* Collected once into the head, so nothing renders here. *@
    Assets.AddStyle(block.Value<string>("css"));
}
else if (alias == AppBlockSchema.ScriptAlias)
{
    @* Collected for the end of the body, after the shell's own scripts. *@
    Assets.AddScript(block.Value<string>("script"));
}
else if (alias == AppBlockSchema.AttachmentsAlias)
{
    @await Html.PartialAsync("~/Views/Partials/ApplicationBlocks/Attachments.cshtml", Model)
}
else if (alias == AppBlockSchema.TabularAlias)
{
    @await Html.PartialAsync("~/Views/Partials/ApplicationBlocks/Tabular.cshtml", Model)
}
else if (alias == AppBlockSchema.ScheduleAlias)
{
    @await Html.PartialAsync("~/Views/Partials/ApplicationBlocks/Schedule.cshtml", Model)
}
else if (alias == AppBlockSchema.AntiSpamAlias && Model.Form is not null)
{
    @await Html.PartialAsync("~/Views/Partials/ApplicationBlocks/AntiSpam.cshtml", Model)
}
else if (alias == "appActions" && Model.Form is not null)
{
    var destination = Model.Form.ReturnUrl(Context.Request.PathBase);
    <div class="app-form-actions">
        <button type="submit" data-save>@(Property("saveLabel") ?? Text["save", "Save"])</button>
        <a href="@destination">@(Property("cancelLabel") ?? Text["cancel", "Cancel"])</a>
        <button type="button" data-delete hidden>@(Property("deleteLabel") ?? Text["delete", "Delete"])</button>
    </div>
}
else if (Model.Form is not null && AppBlockSchema.FieldAliases.Contains(alias))
{
    var key = block.Value<string>("field");
    var field = Model.Form.Resource.Fields.FirstOrDefault(f => f.Key == key);
    if (field is not null)
    {
        var id = "field-" + item.ContentKey.ToString("N");
        var readOnly = field.ReadOnly || block.Value<bool>("readOnly") || alias == "appDisplay";
        var required = field.Required || block.Value<bool>("required");
        var label = Property("label") ?? field.Label;
        var placeholder = Property(AppBlockField.PlaceholderAlias);
        // Resolved now and applied by the runtime to a new record's empty field; null leaves the field as the resource starts it.
        var defaultValue = Model.Variables?.Resolve(Property(AppBlockField.DefaultValueAlias), field.Kind);
        // Razor writes a data-* attribute even when its value is null, so this one is written whole, and only when there is a default.
        var defaultAttribute = defaultValue is null ? HtmlString.Empty : new HtmlString("data-default=\"" + Html.Encode(defaultValue) + "\"");
        if (AppBlockField.IsHidden(block))
        {
            @* Bound and submitted like any other field, but not shown; Items.cshtml gives it no grid cell. *@
            <input type="hidden" id="@id" name="@key" data-field="@key" data-kind="@(alias == AppBlockSchema.ShuttleAlias ? "shuttle" : field.Kind)" data-readonly="@readOnly.ToString().ToLowerInvariant()"
                data-label="@label" @defaultAttribute />
        }
        else
        {
            // A Display value with a link template shows its value as a link, which no label can point at; the link names the label instead.
            var linkTemplate = alias == "appDisplay" ? Property(AppBlockField.LinkTemplateAlias) : null;
            <div class="app-form-field">
                <label id="@id-label" for="@(linkTemplate is not null ? null : alias == AppBlockSchema.ShuttleAlias ? id + "-available" : id)">@(label)@if (required) { <span aria-hidden="true"> *</span> }</label>
                @if (alias == "appTextArea")
                {
                    <textarea id="@id" name="@key" data-field="@key" data-kind="@field.Kind" data-readonly="@readOnly.ToString().ToLowerInvariant()"
                        rows="4" required="@required" readonly="@readOnly" maxlength="@field.MaxLength" placeholder="@placeholder" @defaultAttribute
                        aria-describedby="@id-help @id-error"></textarea>
                }
                else if (alias == AppBlockSchema.ColorAlias)
                {
                    <div class="app-color" data-app-color>
                        @* {label} stands for the field's label, so a translation can put it where its language does. *@
                        <input type="color" data-color-picker disabled="@readOnly" aria-label="@Text["chooseColorFor", "Choose a color for {label}"].Replace("{label}", label)" aria-describedby="@id-help @id-error" />
                        <input type="text" id="@id" name="@key" data-field="@key" data-kind="text" data-readonly="@readOnly.ToString().ToLowerInvariant()"
                            required="@required" readonly="@readOnly" maxlength="@field.MaxLength" pattern="#[0-9a-fA-F]{6}"
                            title="@Text["colorFormat", "Enter a color in #RRGGBB format, such as #2a5d8f."]" placeholder="@(placeholder ?? "#RRGGBB")" spellcheck="false" autocomplete="off"
                            @defaultAttribute aria-describedby="@id-help @id-error" />
                        <button type="button" data-color-clear disabled="@readOnly" aria-label="@Text["clearColorFor", "Clear color for {label}"].Replace("{label}", label)">@Text["clear", "Clear"]</button>
                    </div>
                }
                else if (alias is "appSelect" or AppBlockSchema.ShuttleAlias)
                {
                    IReadOnlyList<FormChoice> choices = field.Choices ?? [];
                    string? listProblem = null;
                    if (Property("listOfValues") is { } selected)
                    {
                        try {
                            // Bounded as the form endpoints bound them, so the page and the runtime's requests bind the same :PARAM values.
                            var parameters = FormRequestValues.Parameters(Context.Request.Query);
                            choices = await Lists.ChoicesAsync(selected, new FormExecutionContext(Context.User, Model.Page.Key, Model.Form.Block.ContentKey, Model.Form.Revision, Parameters: parameters), Context.RequestAborted);
                        }
                        catch (Exception error) when (error is not OperationCanceledException) { choices = []; listProblem = Text["choicesUnavailable", "The choices for this field are not available. Try reloading the page."]; }
                    }
                    @if (alias == AppBlockSchema.ShuttleAlias)
                    {
                        <div class="app-shuttle" data-app-shuttle data-required="@required.ToString().ToLowerInvariant()" role="group" aria-labelledby="@id-label">
                            <input type="hidden" id="@id" name="@key" data-field="@key" data-kind="shuttle" data-readonly="@readOnly.ToString().ToLowerInvariant()" data-label="@label" @defaultAttribute />
                            <div class="app-shuttle-list">
                                <label for="@id-available">@Text["shuttleAvailable", "Available"]</label>
                                <select id="@id-available" data-shuttle-available multiple size="8" disabled="@readOnly" aria-describedby="@id-help @id-error">
                                    @foreach (var choice in choices.Where(choice => ShuttleValue.IsItemValue(choice.Value)).DistinctBy(choice => choice.Value, StringComparer.Ordinal))
                                    { <option value="@choice.Value">@choice.Label</option> }
                                </select>
                            </div>
                            <div class="app-shuttle-actions" aria-label="@Text["shuttleMoveItems", "Move items"]">
                                <button type="button" data-shuttle-action="add" disabled="@readOnly">@Text["shuttleAdd", "Add →"]</button>
                                <button type="button" data-shuttle-action="add-all" disabled="@readOnly">@Text["shuttleAddAll", "Add all →"]</button>
                                <button type="button" data-shuttle-action="remove" disabled="@readOnly">@Text["shuttleRemove", "← Remove"]</button>
                                <button type="button" data-shuttle-action="remove-all" disabled="@readOnly">@Text["shuttleRemoveAll", "← Remove all"]</button>
                            </div>
                            <div class="app-shuttle-list">
                                <label for="@id-selected">@Text["shuttleSelectedHeading", "Selected (in order)"]</label>
                                <select id="@id-selected" data-shuttle-selected multiple size="8" disabled="@readOnly" aria-required="@required.ToString().ToLowerInvariant()" aria-describedby="@id-help @id-error"></select>
                            </div>
                            <div class="app-shuttle-actions" aria-label="@Text["shuttleReorder", "Reorder selected items"]">
                                <button type="button" data-shuttle-action="top" disabled="@readOnly">@Text["shuttleTop", "Top"]</button>
                                <button type="button" data-shuttle-action="up" disabled="@readOnly">@Text["shuttleUp", "Up"]</button>
                                <button type="button" data-shuttle-action="down" disabled="@readOnly">@Text["shuttleDown", "Down"]</button>
                                <button type="button" data-shuttle-action="bottom" disabled="@readOnly">@Text["shuttleBottom", "Bottom"]</button>
                            </div>
                            <span class="app-shuttle-status" role="status" aria-live="polite"></span>
                        </div>
                    }
                    else
                    {
                    @* A select has no placeholder attribute; its empty choice carries the text instead. *@
                    <select id="@id" name="@key" data-field="@key" data-kind="@field.Kind" data-readonly="@readOnly.ToString().ToLowerInvariant()" required="@required" disabled="@readOnly"
                        @defaultAttribute aria-describedby="@id-help @id-error">
                        <option value="">@(placeholder ?? Text["selectValue", "Select a value"])</option>
                        @foreach (var choice in choices) { <option value="@choice.Value">@choice.Label</option> }
                    </select>
                    }
                    @if (listProblem is not null) { <p role="alert">@listProblem</p> }
                }
                else if (linkTemplate is not null)
                {
                    @* The hidden input holds the value as every field does. The runtime writes the link's text from it and its address
                       from the template and the loaded record, and leaves the address out when the value is empty or the address unsafe. *@
                    <input type="hidden" id="@id" name="@key" data-field="@key" data-kind="@field.Kind" data-readonly="true" data-label="@label" @defaultAttribute />
                    <a id="@id-link" class="app-display-link" data-display-link="@key" data-link-template="@linkTemplate.Trim()" aria-labelledby="@id-label @id-link" aria-describedby="@id-help"></a>
                }
                else
                {
                    var inputType = alias switch { "appNumber" => "number", "appDate" => "date", "appTime" => "time", "appDateTime" => "datetime-local", "appCheckbox" => "checkbox", _ => "text" };
                    <input id="@id" name="@key" data-field="@key" data-kind="@field.Kind" data-readonly="@readOnly.ToString().ToLowerInvariant()"
                        type="@inputType" step="@(inputType == "number" ? "any" : null)" min="@field.Minimum" max="@field.Maximum"
                        required="@(required && inputType != "checkbox")" readonly="@readOnly" disabled="@(readOnly && inputType == "checkbox")" maxlength="@field.MaxLength"
                        placeholder="@placeholder" @defaultAttribute aria-describedby="@id-help @id-error" />
                }
                <small id="@id-help">@block.Value("helpText")</small>
                <span id="@id-error" class="app-field-error"></span>
            </div>
        }
    }
}
