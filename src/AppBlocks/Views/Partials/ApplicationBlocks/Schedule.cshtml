@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Options
@using AppBlocks.Blocks
@using AppBlocks.Forms
@using AppBlocks.Schedules
@model AppBlockView
@inject ScheduleQueries Queries
@inject IOptions<ScheduleOptions> Limits
@inject AppBlocksText Text
@*
    Resources against time: the rows of one source down the side, the bars of another across a window of days or
    hours. The server lays the whole table out (Schedules/ScheduleLayout.cs): one cell per row and column, the bars
    as positioned links inside the cell where they start, each in its own sub-row when bars overlap, an open-ended
    bar running to the window's edge. A vertical row is a band across the top whose bars are markers, written top to
    bottom, that shade their columns through every row. A bar with a description is a button that opens the browser's
    own popover with the description and the link, so the details need no script. The runtime only scrolls the window
    to today, shows a bar's details as a tooltip and places an open popover under its bar; without it the table still
    reads and every bar is reachable with the keyboard. Both sources only ever come through the data source engine,
    whose rules assume a known user, so someone not signed in gets the notice even on an open page.
*@
@{
    var item = Model.Block;
    var settings = ScheduleSettings.Read(item.Content);
    var limits = Limits.Value;
    var id = "schedule-" + item.ContentKey.ToString("N");
    var culture = CultureInfo.CurrentUICulture;
    var parameters = FormRequestValues.Parameters(Context.Request.Query);
    var window = ScheduleWindow.Resolve(settings, parameters, DateTime.Now, limits);
    var days = window.Scale == ScheduleScale.Days;
    var level = Math.Clamp(Model.HeadingLevel, 2, 6);
    var heading = new TagBuilder("h" + level);
    heading.AddCssClass("ah-schedule__title");
    heading.Attributes["id"] = id + "-title";
    heading.InnerHtml.Append(settings.Heading ?? "");
    var popovers = 0;
    // A site's text with {0}-style places; one whose places do not match falls back to the English, so a typo never breaks the page.
    string Format(string textId, string english, params object[] values)
    {
        try { return string.Format(culture, Text[textId, english], values); }
        catch (FormatException) { return string.Format(culture, english, values); }
    }
    string Date(DateOnly date) => date.ToString("d MMMM yyyy", culture);
    string Range(ScheduleWindow shown) => Format("scheduleWindow", "{0} to {1}", Date(shown.From), Date(shown.To));
    string Moment(DateTime moment) => days && moment.TimeOfDay == TimeSpan.Zero ? moment.ToString("d MMM yyyy", culture) : moment.ToString("d MMM yyyy HH:mm", culture);
    string Weekday(DateTime date) { var name = date.ToString("ddd", culture).TrimEnd('.'); return name.Length > 2 ? name[..2] : name; }
    // The same page with another window: every other parameter stays, so a form's record or a filter is kept.
    string Address(ScheduleWindow? target)
    {
        var query = Context.Request.Query.Where(p => !p.Key.Equals(ScheduleWindow.FromParameter, StringComparison.OrdinalIgnoreCase) && !p.Key.Equals(ScheduleWindow.ToParameter, StringComparison.OrdinalIgnoreCase))
            .ToDictionary(p => p.Key, p => (string?)p.Value.ToString());
        if (target is not null)
        {
            query[ScheduleWindow.FromParameter] = target.From.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
            query[ScheduleWindow.ToParameter] = target.To.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        }
        return QueryHelpers.AddQueryString(Context.Request.PathBase + Context.Request.Path, query);
    }
    string When(ScheduleBar bar) => bar.EndsAt is { } end ? Format("scheduleBarRange", "{0} to {1}", Moment(bar.StartsAt), Moment(end))
        : bar.OpenEnded ? Format("scheduleBarOnward", "{0} onward", Moment(bar.StartsAt)) : Moment(bar.StartsAt);
    string Details(ScheduleRow row, ScheduleBar bar) => $": {row.Label}, {When(bar)}{(bar.Kind is null ? "" : ", " + bar.Kind)}";
    string KindClass(int index) => index > 0 ? " app-schedule-kind-" + ((index - 1) % 8 + 1) : "";
    // A bar's own colours win over its kind's, so a bar with a colour carries no kind class; the legend keeps the kind's.
    string BarClass(ScheduleBar bar) => "app-schedule-bar" + (bar.Color is null ? KindClass(bar.KindIndex) : "")
        + (bar.OpenEnded ? " app-schedule-bar--open" : "") + (bar.ClippedStart ? " app-schedule-bar--clipped-start" : "") + (bar.ClippedEnd ? " app-schedule-bar--clipped-end" : "");
    string BarStyle(ScheduleBar bar) => FormattableString.Invariant($"--ah-span: {bar.Span}; --ah-lane: {bar.Lane}")
        + (bar.Color is null ? "" : $"; --ah-bar: {bar.Color}") + (bar.TextColor is null ? "" : $"; --ah-bar-text: {bar.TextColor}");
    string? RowStyle(ScheduleRow row) => row.Color is null && row.TextColor is null ? null
        : (row.Color is null ? "" : $"--ah-row: {row.Color};") + (row.TextColor is null ? "" : $" --ah-row-text: {row.TextColor};");
    // A marked column takes its marker's colour, or its kind's through the kind class, and shades itself with it.
    string ColumnClass(ScheduleColumn column) => (column.IsWeekend ? " app-schedule-col--weekend" : "") + (column.IsToday ? " app-schedule-col--today" : "")
        + (column.Marker is { } marker ? " app-schedule-col--marked" + (marker.Color is null ? KindClass(marker.KindIndex) : "") : "");
    string? ColumnStyle(ScheduleColumn column) => column.Marker?.Color is { } color ? $"--ah-mark: {color}" : null;

    void Bar(ScheduleRow row, ScheduleBar bar)
    {
        var classes = BarClass(bar) + (row.Vertical ? " app-schedule-bar--vertical" : "");
        var style = BarStyle(bar);
        if (bar.Description is not null)
        {
            var popover = $"{id}-popover-{++popovers}";
            <button type="button" class="@classes" style="@style" popovertarget="@popover" data-key="@bar.Key" data-kind="@bar.Kind"><span class="app-schedule-bar__label">@bar.Label</span><span class="app-schedule-bar__details">@Details(row, bar)</span></button>
            <div id="@popover" popover class="app-schedule-popover" aria-labelledby="@popover-title">
                <p class="app-schedule-popover__title" id="@popover-title">@bar.Label</p>
                <p class="app-schedule-popover__when">@row.Label, @When(bar)@(bar.Kind is null ? "" : ", " + bar.Kind)</p>
                <p class="app-schedule-popover__text">@bar.Description</p>
                @if (bar.Link is not null) { <p class="app-schedule-popover__link"><a href="@bar.Link">@Text["scheduleOpenLink", "Open link"]</a></p> }
                <button type="button" class="app-schedule-popover__close" popovertarget="@popover" popovertargetaction="hide" aria-label="@Text["scheduleClose", "Close"]">&times;</button>
            </div>
        }
        else if (bar.Link is not null)
        {
            <a class="@classes" href="@bar.Link" style="@style" data-key="@bar.Key" data-kind="@bar.Kind"><span class="app-schedule-bar__label">@bar.Label</span><span class="app-schedule-bar__details">@Details(row, bar)</span></a>
        }
        else
        {
            <span class="@classes" tabindex="0" style="@style" data-key="@bar.Key" data-kind="@bar.Kind"><span class="app-schedule-bar__label">@bar.Label</span><span class="app-schedule-bar__details">@Details(row, bar)</span></span>
        }
    }

    void RowLabel(ScheduleRow row)
    {
        if (row.Description is not null)
        {
            var popover = $"{id}-popover-{++popovers}";
            <th scope="row" class="app-schedule-row-label" style="@RowStyle(row)">
                <button type="button" class="app-schedule-label app-schedule-label--button" popovertarget="@popover">@row.Label</button>
                <div id="@popover" popover class="app-schedule-popover" aria-labelledby="@popover-title">
                    <p class="app-schedule-popover__title" id="@popover-title">@row.Label</p>
                    <p class="app-schedule-popover__text">@row.Description</p>
                    <button type="button" class="app-schedule-popover__close" popovertarget="@popover" popovertargetaction="hide" aria-label="@Text["scheduleClose", "Close"]">&times;</button>
                </div>
            </th>
        }
        else
        {
            <th scope="row" class="app-schedule-row-label" style="@RowStyle(row)"><span class="app-schedule-label">@row.Label</span></th>
        }
    }

    void Row(ScheduleLayout layout, ScheduleRow row)
    {
        var starts = row.Bars.ToLookup(bar => bar.Start);
        <tr class="app-schedule-row@(row.Vertical ? " app-schedule-row--vertical" : "")" style="--ah-lanes: @row.Lanes" data-row-key="@row.Key">
            @{ RowLabel(row); }
            @foreach (var column in layout.Columns)
            {
                <td class="app-schedule-cell@(ColumnClass(column))" style="@ColumnStyle(column)">
                    @foreach (var bar in starts[column.Index]) { Bar(row, bar); }
                </td>
            }
        </tr>
    }
}
@if (!Model.Admitted || Model.Anonymous && !await Queries.AllowsAnonymousReadAsync(settings))
{
    <p class="app-block-signin" role="status">@Text["scheduleSignIn", "Sign in to see the schedule."]</p>
}
else
{
    var data = await Queries.LoadAsync(settings, window, Context.User, Model.Page.Key, item.ContentKey, parameters, Context.RequestAborted);
    var layout = data.Problem is null ? ScheduleLayout.Build(window, data.Rows!, data.Bars!, settings.LinkTemplate, Context.Request.PathBase, settings.HideEmptyRows, limits.Weekend) : null;
    <section class="app-schedule ah-schedule" id="@id" data-app-schedule data-scale="@(days ? "days" : "hours")" aria-labelledby="@(settings.Heading is null ? null : id + "-title")">
        @if (settings.Heading is not null) { @heading }
        @if (settings.Help is not null) { <p class="ah-schedule__help">@settings.Help</p> }
        <div class="app-schedule-toolbar ah-schedule__toolbar">
            <p class="app-schedule-window">@Range(window)</p>
            <div class="app-schedule-controls">
                <details class="app-schedule-jump">
                    <summary>@Text["scheduleJumpTo", "Jump to"]</summary>
                    <div class="app-schedule-jump__panel">
                        <div class="app-schedule-jump__list">
                            <p class="app-schedule-jump__heading" id="@id-months">@Text["scheduleMonths", "Months"]</p>
                            <ul aria-labelledby="@id-months">
                                @foreach (var month in window.Months(12, limits))
                                {
                                    <li><a href="@Address(month)" aria-current="@(month.SameDates(window) ? "true" : null)">@month.From.ToString("MMMM yyyy", culture)</a></li>
                                }
                            </ul>
                        </div>
                        @if (days)
                        {
                            @* A quarter of hour columns would be cut to a month, so hours offer months only. *@
                            <div class="app-schedule-jump__list">
                                <p class="app-schedule-jump__heading" id="@id-quarters">@Text["scheduleQuarters", "Quarters"]</p>
                                <ul aria-labelledby="@id-quarters">
                                    @foreach (var quarter in window.Quarters(6, limits))
                                    {
                                        <li><a href="@Address(quarter)" aria-current="@(quarter.SameDates(window) ? "true" : null)">@Format("scheduleQuarter", "Q{0} {1}", quarter.Quarter, quarter.From.Year)</a></li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </details>
                <nav class="app-schedule-nav" aria-label="@Text["scheduleNavigation", "Schedule window"]">
                    <a href="@Address(window.Shift(-1))" rel="prev">@Text["scheduleEarlier", "Earlier"]</a>
                    <a href="@Address(null)">@Text["scheduleToday", "Today"]</a>
                    <a href="@Address(window.Shift(1))" rel="next">@Text["scheduleLater", "Later"]</a>
                </nav>
            </div>
        </div>
        @if (layout is null)
        {
            <p class="app-schedule-problem" role="alert">@data.Problem</p>
        }
        else if (layout.IsEmpty)
        {
            <p class="app-schedule-empty">@(layout.HiddenRowCount > 0 ? Format("scheduleNoRowsWithBars", "No rows have bars between {0} and {1}.", Date(window.From), Date(window.To)) : Text["scheduleNoRows", "The schedule has no rows to show."])</p>
        }
        else
        {
            <div class="app-schedule-scroll ah-schedule__scroll">
                <table class="app-schedule-table app-schedule-table--@(days ? "days" : "hours")" data-today-column="@layout.TodayColumn">
                    <caption class="app-schedule-caption">@(settings.Heading ?? Text["scheduleCaption", "Schedule"]), @Range(window)</caption>
                    <thead>
                        <tr>
                            <th scope="col" rowspan="2" class="app-schedule-corner"><span class="app-schedule-label"></span></th>
                            @foreach (var period in layout.HeaderGroups)
                            {
                                <th scope="colgroup" colspan="@period.Span" class="app-schedule-period">@(days ? period.Start.ToString("MMMM yyyy", culture) : period.Start.ToString("ddd d MMMM yyyy", culture))</th>
                            }
                        </tr>
                        <tr>
                            @foreach (var column in layout.Columns)
                            {
                                <th scope="col" class="app-schedule-col@(ColumnClass(column))" style="@ColumnStyle(column)" aria-current="@(column.IsToday ? "date" : null)">
                                    @if (days)
                                    {
                                        <span class="app-schedule-day">@column.Start.Day</span><span class="app-schedule-weekday">@Weekday(column.Start)</span>
                                    }
                                    else
                                    {
                                        <span class="app-schedule-day">@column.Start.ToString("HH", culture)</span>
                                    }
                                </th>
                            }
                        </tr>
                    </thead>
                    @if (layout.Markers.Count > 0)
                    {
                        <tbody class="app-schedule-group app-schedule-markers">
                            @foreach (var row in layout.Markers) { Row(layout, row); }
                        </tbody>
                    }
                    @foreach (var group in layout.Groups)
                    {
                        <tbody class="app-schedule-group">
                            @if (group.Title is not null)
                            {
                                <tr class="app-schedule-group-title"><th scope="rowgroup" colspan="@(layout.Columns.Count + 1)"><span class="app-schedule-label">@group.Title</span></th></tr>
                            }
                            @foreach (var row in group.Rows) { Row(layout, row); }
                        </tbody>
                    }
                </table>
            </div>
            @if (layout.BarCount == 0)
            {
                <p class="app-schedule-empty">@Format("scheduleNoBars", "No bars between {0} and {1}.", Date(window.From), Date(window.To))</p>
            }
            @if (layout.HiddenRowCount > 0)
            {
                <p class="app-schedule-empty">@(layout.HiddenRowCount == 1 ? Text["scheduleOneRowHidden", "One row without bars in this window is not shown."] : Format("scheduleRowsHidden", "{0} rows without bars in this window are not shown.", layout.HiddenRowCount))</p>
            }
            @if (layout.Legend.Count > 0)
            {
                <ul class="app-schedule-legend ah-schedule__legend" aria-label="@Text["scheduleLegend", "Legend"]">
                    @foreach (var entry in layout.Legend)
                    {
                        <li><span class="app-schedule-swatch@(KindClass(entry.Index))" aria-hidden="true"></span>@entry.Kind</li>
                    }
                </ul>
            }
        }
    </section>
}
