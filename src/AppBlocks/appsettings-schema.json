{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "allOf": [
    {
      "$ref": "https://json.schemastore.org/appsettings.json"
    },
    {
      "$ref": "appsettings-schema.Umbraco.Cms.json#"
    }
  ],
  "properties": {
    "AppBlocks": {
      "type": "object",
      "properties": {
        "NoStorePages": {
          "type": "string",
          "enum": [
            "All pages",
            "App Blocks Pages",
            "Off"
          ],
          "default": "App Blocks Pages",
          "description": "Pages for which AppBlocks sets no-store and prevents output-cache storage. API cache headers are independent."
        }
      }
    }
  }
}