{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "allOf": [
    {
      "$ref": "https://json.schemastore.org/appsettings.json"
    },
    {
      "$ref": "appsettings-schema.Umbraco.Cms.json#"
    }
  ],
  "properties": {
    "AppBlocks": {
      "type": "object",
      "properties": {
        "NoStorePages": {
          "type": "string",
          "enum": [
            "AppBlocksPages",
            "AllPages",
            "Off"
          ],
          "default": "AppBlocksPages",
          "description": "Pages for which AppBlocks sets no-store and prevents output-cache storage: those with a block whose output depends on who asks, every page, or none. API cache headers are independent."
        }
      }
    }
  }
}