{
  "id": "AppBlocks",
  "name": "AppBlocks",
  "version": "0.1.0-alpha.1",
  "extensions": [
    {
      "type": "menu", "alias": "AppBlocks.Menu", "name": "AppBlocks menu"
    },
    {
      "type": "sectionSidebarApp", "kind": "menu", "alias": "AppBlocks.Sidebar", "name": "AppBlocks sidebar",
      "weight": 140,
      "meta": { "label": "AppBlocks", "menu": "AppBlocks.Menu" },
      "conditions": [{ "alias": "Umb.Condition.SectionAlias", "match": "Umb.Section.Settings" }]
    },
    {
      "type": "menuItem", "alias": "AppBlocks.MenuItem", "name": "AppBlocks menu item",
      "meta": { "label": "AppBlocks", "icon": "icon-box", "entityType": "appblocks", "menus": ["AppBlocks.Menu"] }
    },
    {
      "type": "workspace", "kind": "default", "alias": "AppBlocks.Workspace", "name": "AppBlocks workspace",
      "element": "/App_Plugins/AppBlocks/dashboard.js",
      "meta": { "entityType": "appblocks", "headline": "AppBlocks" }
    },
    {
      "type": "propertyEditorUi", "alias": "AppBlocks.ConnectionPicker", "name": "AppBlocks connection",
      "element": "/App_Plugins/AppBlocks/connection-picker.js",
      "meta": { "label": "Database connection", "icon": "icon-server", "group": "AppBlocks", "propertyEditorSchemaAlias": "Umbraco.TextBox" }
    },
    {
      "type": "propertyEditorUi", "alias": "AppBlocks.TablePicker", "name": "AppBlocks table",
      "element": "/App_Plugins/AppBlocks/table-picker.js",
      "meta": { "label": "Table or SELECT", "icon": "icon-table", "group": "AppBlocks", "propertyEditorSchemaAlias": "Umbraco.TextArea" }
    }
  ]
}
