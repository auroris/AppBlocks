<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="6a79805a-4170-811d-64a8-83ee1422bade" Alias="sqlDataSource" Level="2">
  <Info>
    <Name>SQL data source</Name>
    <Icon>icon-server</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>A table, view or SELECT that forms and reports read, and forms write, through a connection. AppBlocks discovers the fields, and publishing checks it against the database.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays>
      </KeepAllVersionsNewerThanDays>
      <KeepLatestVersionPerDayForDays>
      </KeepLatestVersionPerDayForDays>
    </HistoryCleanup>
    <Folder>AppBlocks</Folder>
    <Compositions />
    <DefaultTemplate>
    </DefaultTemplate>
    <AllowedTemplates />
    <AllowedInLibrary>false</AllowedInLibrary>
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>455d7c77-32dd-46e3-a61b-af728e859742</Key>
      <Name>Access</Name>
      <Alias>access</Alias>
      <Definition>3df70151-e67d-4bae-98c9-d5413e4eead5</Definition>
      <Type>Umbraco.RadioButtonList</Type>
      <Mandatory>false</Mandatory>
      <Validation></Validation>
      <Description><![CDATA[Public (default): anyone who can access the page may read its data. Not public: also require a signed-in Member or backoffice User. Specific groups: select the Member groups below. Empty means Public unless read groups are already set. Page access and policies always apply, including to API requests. Queries and row restrictions using :USER_* values still require sign-in. Writes always require sign-in.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="access">Access</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage></MandatoryMessage>
      <ValidationRegExpMessage></ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>53e21412-a5ee-4e43-bd62-6d1d2966587e</Key>
      <Name>Test</Name>
      <Alias>dataSourceTest</Alias>
      <Definition>4d5a03ab-16ab-4e7c-9d81-282fe72fc35a</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation>
      </Validation>
      <Description><![CDATA[Test the current definition with sample bind values before publishing.]]></Description>
      <SortOrder>99</SortOrder>
      <Tab Alias="definition">Definition</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>
      </MandatoryMessage>
      <ValidationRegExpMessage>
      </ValidationRegExpMessage>
      <LabelOnTop>true</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>1cebeb2b-0047-96c5-33df-5324b116c2d6</Key>
      <Name>Alias</Name>
      <Alias>alias</Alias>
      <Definition>90cb2487-adcb-2ec5-c4a0-840175ba5424</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation>
      </Validation>
      <Description><![CDATA[The name a Form interface selects, such as orders: letters, digits, '.', '-' and '_', starting with a letter.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="definition">Definition</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage>
      </MandatoryMessage>
      <ValidationRegExpMessage>
      </ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
