<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="299d9d6d-c1f6-4391-914d-38141159a69b" Alias="apiEndpoint" Level="2">
  <Info>
    <Name>API endpoint</Name>
    <Icon>icon-plug</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>A route below the API base path that serves a SQL data source's rows as JSON over GET, like an Oracle APEX RESTful service.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>false</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays />
      <KeepLatestVersionPerDayForDays />
    </HistoryCleanup>
    <Folder>AppBlocks</Folder>
    <Compositions />
    <DefaultTemplate />
    <AllowedTemplates />
    <AllowedInLibrary>false</AllowedInLibrary>
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>9d9c5a12-4d42-420d-91af-3766d5d9849a</Key>
      <Name>Alias</Name>
      <Alias>alias</Alias>
      <Definition>90cb2487-adcb-2ec5-c4a0-840175ba5424</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation />
      <Description><![CDATA[The endpoint's name in diagnostics and logs, such as orders.lines: letters, digits, '.', '-' and '_', starting with a letter.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="definition">Definition</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>548c0ca4-9873-4b48-9bfb-9ef46abfa9a7</Key>
      <Name>Route</Name>
      <Alias>route</Alias>
      <Definition>e45154ee-9f59-4046-9488-4e3f942aed6b</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation />
      <Description><![CDATA[The path below the API base path, such as orders/:id/lines: up to 8 segments separated by '/', each a literal or a :name parameter. A :name segment binds as :PARAM.name in the SQL. No two published endpoints may answer the same requests.]]></Description>
      <SortOrder>1</SortOrder>
      <Tab Alias="definition">Definition</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>981275c0-d172-4a64-98fd-3848090de425</Key>
      <Name>SQL data source</Name>
      <Alias>dataSource</Alias>
      <Definition>32f959d2-f116-57de-20b7-e54c95db31cc</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[Choose a published SQL data source, whose access, row restriction, policies and backing class apply; or leave it empty and enter the endpoint's own connection and SQL below, with its own access.]]></Description>
      <SortOrder>2</SortOrder>
      <Tab Alias="definition">Definition</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>7619460f-7f17-45e8-ada1-eecbbb716da8</Key>
      <Name>Connection</Name>
      <Alias>connection</Alias>
      <Definition>0bb63f2b-95ed-4a5a-81d4-5a7ddcd52751</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[Only for the endpoint's own SQL: the database it reads, the separate AppBlocks database by default.]]></Description>
      <SortOrder>3</SortOrder>
      <Tab Alias="definition">Definition</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>f4190ff7-043e-477e-ac62-1624de386d16</Key>
      <Name>SQL</Name>
      <Alias>sql</Alias>
      <Definition>64d2fba9-1cb2-490b-9de9-37211a072cf4</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[Only without a data source: a table name or a SELECT without ORDER BY, with the bind variables a data source's row source takes (:USER_*, :NOW, :PARAM.name and :APP.name). Set its Access on the Access tab.]]></Description>
      <SortOrder>4</SortOrder>
      <Tab Alias="definition">Definition</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>711ce6d9-257c-418e-897a-864dca2ae82b</Key>
      <Name>Query parameters</Name>
      <Alias>queryParameters</Alias>
      <Definition>90cb2487-adcb-2ec5-c4a0-840175ba5424</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[The :PARAM. names the query string may fill, separated by commas, such as status, from. Every :PARAM. the SQL uses must be a route parameter or listed here; a route parameter wins over a query parameter of the same name.]]></Description>
      <SortOrder>5</SortOrder>
      <Tab Alias="definition">Definition</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>e1c16f86-3f19-4ff8-b169-b95a1fad8228</Key>
      <Name>Shape</Name>
      <Alias>shape</Alias>
      <Definition>bfc7746c-600e-4be7-a211-073342196a38</Definition>
      <Type>Umbraco.RadioButtonList</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[Collection, the default: { "items": [ ... ] } with every row. Single: the first row as one object, and 404 when there is none.]]></Description>
      <SortOrder>6</SortOrder>
      <Tab Alias="definition">Definition</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>126b0eab-cf23-40b5-aed2-04604be0a005</Key>
      <Name>Order by</Name>
      <Alias>orderBy</Alias>
      <Definition>90cb2487-adcb-2ec5-c4a0-840175ba5424</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[Optional columns to sort by, separated by commas, each optionally followed by DESC, such as ORDER_DATE DESC, ORDER_ID. Without it, the database decides the order.]]></Description>
      <SortOrder>7</SortOrder>
      <Tab Alias="definition">Definition</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>2eb84043-4228-4d56-8060-a5148d046aab</Key>
      <Name>Maximum rows</Name>
      <Alias>maximumRows</Alias>
      <Definition>90cb2487-adcb-2ec5-c4a0-840175ba5424</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[Maximum rows a collection returns; defaults to 1000. A larger result is an error, never a silently shorter list: narrow the query or increase this value.]]></Description>
      <SortOrder>8</SortOrder>
      <Tab Alias="definition">Definition</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>c9c1e342-2f0b-4b56-ae9c-f2d9c67be87d</Key>
      <Name>Test</Name>
      <Alias>endpointTest</Alias>
      <Definition>71ccaa02-c4e2-47fc-aada-f3919562a0c4</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[Call the endpoint as you, with sample parameter values, before publishing.]]></Description>
      <SortOrder>9</SortOrder>
      <Tab Alias="definition">Definition</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>4b162f5c-f4a9-4b90-bc1c-e52e3ce1775a</Key>
      <Name>Access</Name>
      <Alias>access</Alias>
      <Definition>3df70151-e67d-4bae-98c9-d5413e4eead5</Definition>
      <Type>Umbraco.RadioButtonList</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[Only for the endpoint's own SQL; with a data source, its access applies and this stays empty. There is no page, so Public means anyone who has the URL. Not public: a signed-in Member or backoffice User. Specific groups: Members of the read groups below. SQL using :USER_* values always requires sign-in.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="access">Access</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>6d0f75d4-b725-43d7-b893-62d39b69fab7</Key>
      <Name>Read groups</Name>
      <Alias>readGroups</Alias>
      <Definition>b11c6fc7-5003-09af-5c9d-7dae42cd813b</Definition>
      <Type>Umbraco.MemberGroupPicker</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[Only for the endpoint's own SQL with Specific groups access: the Member groups that may read.]]></Description>
      <SortOrder>1</SortOrder>
      <Tab Alias="access">Access</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>1a925c03-d893-41ab-b75b-90766d8a064e</Key>
      <Name>Row restriction</Name>
      <Alias>rowRestriction</Alias>
      <Definition>306b51cd-102b-ad7d-459c-be97ee8778e7</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[Only for the endpoint's own SQL: an optional predicate added to every read, such as OWNER_SID = :USER_SID. It may use :USER_* values, :NOW and :APP. values, never request parameters.]]></Description>
      <SortOrder>2</SortOrder>
      <Tab Alias="access">Access</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
