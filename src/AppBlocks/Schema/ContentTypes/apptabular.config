<ContentType Key="50f10848-f57d-705a-5ccb-bcbd4e49d613" Alias="appTabular" Level="2">
  <Info>
    <Name>Tabular form</Name>
    <Icon>icon-table</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>The rows of a record, edited several at a time: a child data source whose link field holds the record's key. Inside a form the record is the form's; on its own the block names the owner.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays />
      <KeepLatestVersionPerDayForDays />
    </HistoryCleanup>
    <Folder>Application</Folder>
    <Compositions />
    <DefaultTemplate />
    <AllowedTemplates />
    <AllowedInLibrary>false</AllowedInLibrary>
  </Info>
