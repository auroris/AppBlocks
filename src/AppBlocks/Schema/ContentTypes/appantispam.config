<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="bb529b16-87cc-a2f5-2806-165bb5edcd8c" Alias="appAntiSpam" Level="2">
  <Info>
    <Name>Anti-spam</Name>
    <Icon>icon-shield</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>Place inside a form. AppBlocks checks each submission on the server before the form's class runs. Cloudflare Turnstile, Google reCAPTCHA and hCaptcha load third-party scripts in the visitor's browser and may need cookie consent on some sites; consent handling stays with the site, and a site with its own Content-Security-Policy has to allow the scripts. The honeypot loads nothing and needs no account.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays />
      <KeepLatestVersionPerDayForDays />
    </HistoryCleanup>
    <Folder>AppBlocks</Folder>
    <Compositions />
    <DefaultTemplate />
    <AllowedTemplates />
    <AllowedInLibrary>false</AllowedInLibrary>
  </Info>
  <Structure />
  <GenericProperties>
    <GenericProperty>
      <Key>954142d9-a1c6-0243-5157-511ba8a98be4</Key>
      <Name>Service</Name>
      <Alias>service</Alias>
      <Definition>4600050e-1256-3c89-8cf0-d127bfcf9354</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation />
      <Description><![CDATA[Which check protects this form. The honeypot needs no account; the others need a site key and a secret key from the service. An administrator adds the secret key in Settings, AppBlocks, Anti-spam. A secret key never goes in a block.]]></Description>
      <SortOrder>0</SortOrder>
      <Tab Alias="configuration">Configuration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>e127a515-2324-4533-0726-8a67f3971fa7</Key>
      <Name>Site key</Name>
      <Alias>siteKey</Alias>
      <Definition>90cb2487-adcb-2ec5-c4a0-840175ba5424</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation><![CDATA[^[A-Za-z0-9_.:-]*$]]></Validation>
      <Description><![CDATA[The service's public site key. Leave empty to use the one set in Settings, AppBlocks, Anti-spam. The honeypot has none.]]></Description>
      <SortOrder>1</SortOrder>
      <Tab Alias="configuration">Configuration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage>A site key holds letters, digits, hyphens, underscores, dots and colons.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>515bd229-dc89-3877-4a07-e6a0a2244cf4</Key>
      <Name>Score threshold</Name>
      <Alias>scoreThreshold</Alias>
      <Definition>90cb2487-adcb-2ec5-c4a0-840175ba5424</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation><![CDATA[^$|^(0(\.[0-9]+)?|1(\.0+)?)$]]></Validation>
      <Description><![CDATA[reCAPTCHA v3 only: the lowest score that passes, from 0 to 1. Leave empty for 0.5.]]></Description>
      <SortOrder>2</SortOrder>
      <Tab Alias="configuration">Configuration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage>Enter a number from 0 to 1, such as 0.5.</ValidationRegExpMessage>
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>26e2059a-0cbf-8963-ff77-8176efb30b6b</Key>
      <Name>Theme</Name>
      <Alias>theme</Alias>
      <Definition>fb58028e-98a3-6891-8534-f80a62884bbe</Definition>
      <Type>Umbraco.RadioButtonList</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[How a visible widget looks. Only Turnstile follows the visitor's own setting on auto; the others show light.]]></Description>
      <SortOrder>3</SortOrder>
      <Tab Alias="configuration">Configuration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>c737933a-6fbb-fdeb-60c2-a4144b5aaaf3</Key>
      <Name>Size</Name>
      <Alias>size</Alias>
      <Definition>a9b89392-84b2-0961-0045-c3ef999cac83</Definition>
      <Type>Umbraco.RadioButtonList</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[How large a visible widget is.]]></Description>
      <SortOrder>4</SortOrder>
      <Tab Alias="configuration">Configuration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
  </GenericProperties>
  <Tabs>
    <Tab>
      <Key>1d985b8d-f741-e3ac-a1d7-9d796c3783b1</Key>
      <Caption>Configuration</Caption>
      <Alias>configuration</Alias>
      <Type>Group</Type>
      <SortOrder>0</SortOrder>
