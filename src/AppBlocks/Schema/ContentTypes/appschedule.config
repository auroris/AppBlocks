      <Alias>barsSource</Alias>
      <Definition>90cb2487-adcb-2ec5-c4a0-840175ba5424</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>true</Mandatory>
      <Validation />
      <Description><![CDATA[The alias of the source whose rows are the bars, with the columns key, row, start, end, label, kind and link. The row is the key of a row; an empty end runs the bar to the window's edge; :PARAM.from and :PARAM.to bind the window shown.]]></Description>
      <SortOrder>3</SortOrder>
      <Tab Alias="configuration">Configuration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
