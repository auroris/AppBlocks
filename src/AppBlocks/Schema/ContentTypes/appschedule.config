<ContentType Key="dad30501-a579-78e7-82b9-6c35abcb2bb0" Alias="appSchedule" Level="2">
  <Info>
    <Name>Schedule</Name>
    <Icon>icon-calendar-alt</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>Resources against time: the rows of one source down the side, the bars of another across a window of days or hours set by the page's from and to parameters.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays />
      <KeepLatestVersionPerDayForDays />
    </HistoryCleanup>
    <Folder>AppBlocks</Folder>
    <Compositions />
    <DefaultTemplate />
    <AllowedTemplates />
    <AllowedInLibrary>false</AllowedInLibrary>
  </Info>
