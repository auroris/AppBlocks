      <Mandatory>true</Mandatory>
      <Validation />
      <Description><![CDATA[The alias of a published report definition that selects a data source, or of a data source. Its rows need the columns key, label and group, in any letter case; one row of the schedule per row.]]></Description>
      <SortOrder>2</SortOrder>
      <Tab Alias="configuration">Configuration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
