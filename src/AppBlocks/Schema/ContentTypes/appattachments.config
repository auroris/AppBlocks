<?xml version="1.0" encoding="utf-8"?>
<ContentType Key="7c6b382b-d731-5610-b5b9-335388d8c4ab" Alias="appAttachments" Level="2">
  <Info>
    <Name>Attachments</Name>
    <Icon>icon-attachment</Icon>
    <Thumbnail>folder.png</Thumbnail>
    <Description>Files that belong to a record, kept in the attachments database. Inside a form they belong to the form's record; on its own the block names the record.</Description>
    <AllowAtRoot>False</AllowAtRoot>
    <ListView>00000000-0000-0000-0000-000000000000</ListView>
    <Variations>Nothing</Variations>
    <IsElement>true</IsElement>
    <HistoryCleanup>
      <PreventCleanup>False</PreventCleanup>
      <KeepAllVersionsNewerThanDays />
      <KeepLatestVersionPerDayForDays />
    </HistoryCleanup>
    <Folder>AppBlocks</Folder>
    <Compositions />
    <DefaultTemplate />
    <AllowedTemplates />
    <AllowedInLibrary>false</AllowedInLibrary>
  </Info>
