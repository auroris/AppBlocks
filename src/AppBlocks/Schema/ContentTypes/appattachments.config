      <Alias>purposes</Alias>
      <Definition>306b51cd-102b-ad7d-459c-be97ee8778e7</Definition>
      <Type>Umbraco.TextArea</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[One per line, such as Invoice or Identification. A file is filed under one of them; empty offers no purpose.]]></Description>
      <SortOrder>4</SortOrder>
      <Tab Alias="configuration">Configuration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
