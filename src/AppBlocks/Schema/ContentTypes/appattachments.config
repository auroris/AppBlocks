      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>22935bd5-9c74-4e35-9712-f058b3d32a8d</Key>
      <Name>Owner resource</Name>
      <Alias>ownerResource</Alias>
      <Definition>9d07467f-c5f8-6c9b-ab3e-66c7a2341679</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[Leave empty to keep the files on the record of the form this block is placed in. Select a resource or data source to show another record's files; then set the owner key.]]></Description>
      <SortOrder>2</SortOrder>
      <Tab Alias="configuration">Configuration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>d4b61ef5-a5c7-4ff3-8198-480fcdcec6fd</Key>
      <Name>Owner key</Name>
      <Alias>ownerKey</Alias>
      <Definition>90cb2487-adcb-2ec5-c4a0-840175ba5424</Definition>
      <Type>Umbraco.TextBox</Type>
      <Mandatory>false</Mandatory>
      <Validation />
      <Description><![CDATA[With an owner resource: :PARAM.name takes the record key from the page's address, :FIELD.alias from a field of the record the enclosing form loaded; any other text is the key itself.]]></Description>
      <SortOrder>3</SortOrder>
      <Tab Alias="configuration">Configuration</Tab>
      <Variations>Nothing</Variations>
      <MandatoryMessage />
      <ValidationRegExpMessage />
      <LabelOnTop>false</LabelOnTop>
    </GenericProperty>
    <GenericProperty>
      <Key>22c64181-af14-40c1-8fa9-23ceb876a217</Key>
