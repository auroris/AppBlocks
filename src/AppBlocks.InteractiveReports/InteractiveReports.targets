<Project>
  <!-- Applied only to the source dependency, without changing the sibling repository.
       Generate and collect resources in that project so the first build embeds them. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'InteractiveReport.Client.Json'">
    <ReportsUiRoot>$(MSBuildProjectDirectory)\..\..</ReportsUiRoot>
    <ReportsUiOutput>$(MSBuildProjectDirectory)\Ui\dist</ReportsUiOutput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Update="@(ProjectReference)"
                      GlobalPropertiesToRemove="%(ProjectReference.GlobalPropertiesToRemove);CustomAfterMicrosoftCommonTargets" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'InteractiveReport.Client.Json'">
    <ReportsUiSource Include="$(ReportsUiRoot)\src\client\**\*;$(ReportsUiRoot)\docs\**\*;$(ReportsUiRoot)\scripts\build-client.mjs;$(ReportsUiRoot)\scripts\build-help.mjs;$(ReportsUiRoot)\package.json;$(ReportsUiRoot)\package-lock.json" />
  </ItemGroup>
  <Target Name="RestoreReportsUi" Condition="'$(MSBuildProjectName)' == 'InteractiveReport.Client.Json' and '$(DesignTimeBuild)' != 'true'"
          Inputs="$(ReportsUiRoot)\package.json;$(ReportsUiRoot)\package-lock.json"
          Outputs="$(ReportsUiRoot)\node_modules\.package-lock.json">
    <Exec WorkingDirectory="$(ReportsUiRoot)" Command="npm ci --no-audit --no-fund" />
  </Target>
  <Target Name="BuildReportsUi" BeforeTargets="BeforeBuild;EnsureUiBundlesOnReleaseBuild;EnsureUiBundlesOnPack"
          DependsOnTargets="RestoreReportsUi" Condition="'$(MSBuildProjectName)' == 'InteractiveReport.Client.Json' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(ReportsUiSource)"
          Outputs="$(ReportsUiOutput)\ir.js;$(ReportsUiOutput)\ir-admin.js;$(ReportsUiOutput)\ir-chart.js;$(ReportsUiOutput)\help.en.html">
    <Exec WorkingDirectory="$(ReportsUiRoot)" Command="npm run build:client" />
    <Exec WorkingDirectory="$(ReportsUiRoot)" Command="node scripts/build-help.mjs" />
  </Target>
  <Target Name="IncludeReportsUi" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildReportsUi"
          Condition="'$(MSBuildProjectName)' == 'InteractiveReport.Client.Json'">
    <ItemGroup>
      <EmbeddedResource Remove="Ui\dist\*" />
      <_ReportsUiAsset Include="Ui\dist\*" />
      <EmbeddedResource Include="@(_ReportsUiAsset)" WithCulture="false"
                        LogicalName="InteractiveReport.Client.Json.Ui.%(_ReportsUiAsset.Filename)%(_ReportsUiAsset.Extension)" />
    </ItemGroup>
  </Target>
</Project>
