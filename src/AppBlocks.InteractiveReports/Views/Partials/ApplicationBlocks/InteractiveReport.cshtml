@using UmbracoAppHost.Blocks
@model AppBlockView
@inject IVariationContextAccessor VariationContext
@{
    var item = Model.Block;
    var block = item.Content;
    var alias = block.ContentType.Alias;
    // Umbraco returns an empty string, not null, for a text property nobody filled in, so a ?? fallback needs this.
    string? Text(string property) => block.Value<string>(property) is { } value && !string.IsNullOrWhiteSpace(value) ? value : null;
    var heading = Text("heading");
    var paperReport = block.Value<IPublishedContent>("paperReport");
    var printUrl = paperReport is null ? null : Context.RequestServices.GetService<AppBlocks.Documents.IAppDocumentLinks>()?.Url(paperReport.Key, Context.Request.PathBase);
    var culture = VariationContext.VariationContext?.Culture;
    var apiQuery = culture is not null && Model.Page.Cultures.ContainsKey(culture) ? "?" + AppBlockContent.CultureParameter + "=" + Uri.EscapeDataString(culture) : "";
}

@if (Model.MemberId is null)
{
    <p class="app-block-signin" role="status">Sign in to use this report.</p>
}
else
{
    var name = AppBlockContent.ReportName(Model.Page.Key, item.ContentKey);
    var controls = block.Value<string>("controls");
    <section class="app-block-report">
        @if (printUrl is not null) { <p class="app-report-actions"><a href="@(printUrl + Context.Request.QueryString)" target="_blank" rel="noopener">Print</a></p> }
        <template data-app-report data-state-key="@(Model.MemberId):@name:@culture" data-print-url="@printUrl"
            data-print-key-column="@Text("keyColumn")" data-print-key-parameter="@(Text("keyParameter") ?? "id")">
            <interactive-report report="@name" report-title="@(heading ?? Text("reportName"))"
                api-base="@(Context.Request.PathBase.ToString() + "/api/reports" + apiQuery)" download-base="@(Context.Request.PathBase.ToString() + "/api/download" + apiQuery)"
                initial-page-size="@(block.Value<int?>("pageSize") is > 0 and var size ? size : (int?)null)"
                controls="@(string.IsNullOrWhiteSpace(controls) ? null : controls)" empty-message="@(block.Value<string>("emptyMessage"))"></interactive-report>
        </template>
    </section>
}

@if (!Context.Items.ContainsKey("AppBlocks.InteractiveReports.Assets"))
{
    Context.Items["AppBlocks.InteractiveReports.Assets"] = true;
    <script type="module" src="@(Context.Request.PathBase)/App_Plugins/ApplicationBlocks/reports.js" nonce="@AppPageAssets.Nonce(Context)"></script>
}
